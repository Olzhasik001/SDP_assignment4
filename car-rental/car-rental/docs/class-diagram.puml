@startuml
skinparam classAttributeIconSize 0
left to right direction

class ConsoleApp <<Client>>
class RentalSystem <<composition root>>

package facade {
  class RentalFacade {
    +rentCar(RentalRequest): RentalOrder
    +rentCarAndCrashBeforeC(RentalRequest): RentalOrder
  }
  class RentalAdminFacade {
    +listOrders()
    +inspect(id): String
    +manualCompensate(id)
    +recoverPending()
  }
  class RentalOrder
  class RentalRequest
  class RentalOrderRepository
  class InvalidRentalRequestException
}

package "Subsystem A: fleet" {
  class FleetAvailabilityTracker
  class PricingEngine <<business logic>>
  class Reservation <<entity: HELD/CONFIRMED/RELEASED>>
  class Car
  class ReservationRepository <<gateway>>
  class NoCarAvailableException
}

package "Subsystem B: billing" {
  class DepositHandler
  class InsuranceCalculator <<business logic>>
  class Deposit <<entity: HELD/CAPTURED/REFUNDED>>
  class InsurancePolicy <<QUOTED/ACTIVE/CANCELLED>>
  class BillingRepository <<gateway>>
  class DepositDeclinedException
}

package "Subsystem C: handover" {
  class DamageInspector
  class GpsTracker
  class DamageRules <<business logic>>
  class Inspection <<entity: PENDING/PASSED/FAILED/VOIDED>>
  class HandoverRepository <<gateway>>
  class DamageFoundException
  class GpsUnavailableException
}

ConsoleApp --> RentalSystem
ConsoleApp --> RentalFacade
ConsoleApp --> RentalAdminFacade
RentalSystem ..> RentalFacade : creates
RentalSystem ..> RentalAdminFacade : creates

RentalFacade --> FleetAvailabilityTracker
RentalFacade --> DepositHandler
RentalFacade --> DamageInspector
RentalFacade --> GpsTracker
RentalFacade --> RentalOrderRepository
RentalAdminFacade --> FleetAvailabilityTracker
RentalAdminFacade --> DepositHandler
RentalAdminFacade --> DamageInspector
RentalAdminFacade --> GpsTracker
RentalAdminFacade --> RentalOrderRepository
RentalOrderRepository ..> RentalOrder
RentalFacade ..> RentalRequest

FleetAvailabilityTracker --> ReservationRepository
FleetAvailabilityTracker --> PricingEngine
ReservationRepository ..> Reservation
ReservationRepository ..> Car

DepositHandler --> BillingRepository
DepositHandler --> InsuranceCalculator
BillingRepository ..> Deposit
BillingRepository ..> InsurancePolicy

DamageInspector --> HandoverRepository
DamageInspector --> DamageRules
GpsTracker --> HandoverRepository
HandoverRepository ..> Inspection

note bottom of RentalFacade
 A, B and C never reference each other.
 They only meet inside the facades.
end note
@enduml
